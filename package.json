{
  "name": "linkedin-automator",
  "version": "0.1.0",
  "description": "LinkedIn automation built on api-anything (execution engine) and rea (reverse-engineering): prospecting, outreach campaigns and post scheduling.",
  "license": "MIT",
  "author": "instax-dutta",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/instax-dutta/linkedin-automator.git"
  },
  "homepage": "https://github.com/instax-dutta/linkedin-automator#readme",
  "bugs": {
    "url": "https://github.com/instax-dutta/linkedin-automator/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "linkedin-automator": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "specs",
    "AGENTS.md",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "verify": "node scripts/verify-suite.mjs",
    "cli": "tsx src/cli.ts"
  },
  "keywords": [
    "linkedin",
    "automation",
    "outreach",
    "api-anything",
    "rea",
    "reverse-engineering",
    "mcp"
  ],
  "dependencies": {
    "api-anything": "github:goodnight000/api-anything#1788526eb54ff1f0d8bd7373bd5fdcac143ad7ad"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "github:goodnight000/api-anything#1788526eb54ff1f0d8bd7373bd5fdcac143ad7ad": true,
    "esbuild@0.28.2": true
  }
}
